{
  "name": "cognitive-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Cognitive Workspace - Next.js Frontend and FastAPI Backend",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "uv run --directory backend uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "npm run start --prefix frontend",
    "lint": "npm run lint --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
