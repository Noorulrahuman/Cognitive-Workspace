# Copy this file to .env and fill in real values:  copy .env.example .env

# General
PROJECT_NAME="Cognitive Workspace API"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"
FRONTEND_URL=http://localhost:3000

# Database (required)
